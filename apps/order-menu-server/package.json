{
  "name": "@proj-airi/order-menu-server",
  "type": "module",
  "private": true,
  "description": "Local POS Bridge and controllable POS simulator for the Order Menu.",
  "scripts": {
    "apply:env": "dotenvx run -f .env.local --overload --ignore=MISSING_ENV_FILE",
    "dev": "pnpm run apply:env -- tsx --watch src/bin/run.ts",
    "start": "pnpm run apply:env -- tsx src/bin/run.ts",
    "test:run": "vitest run",
    "menu:check": "tsx src/bin/check-menu-prices.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:vitest"
  }
}
