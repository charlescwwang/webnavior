{
  "name": "@proj-airi/stage-kiosk-desktop",
  "type": "module",
  "version": "0.7.8-rc.6",
  "private": true,
  "description": "Windows Kiosk host for AIRI and approved external service pages",
  "main": "out/main/index.js",
  "scripts": {
    "build": "node ../../scripts/buildKioskPbService.mjs && electron-vite build",
